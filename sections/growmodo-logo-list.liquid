{% render 'growmodo-logo-list-css' %}

{%- if section.blocks.size > 0 -%}
  <div class="growmodo-logo-list growmodo-{{ section.id }}-container">
    <div class="page-width">
      <ul class="growmodo-logo-list__list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'logo' -%}
            <li class="growmodo-logo-list__item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- liquid
                  if block.settings.alt != blank
                    assign logo_alt = block.settings.alt | escape
                  else
                    assign logo_alt = block.settings.image.alt | escape
                  endif
                -%}

                {%- if block.settings.link != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="growmodo-logo-list__link"
                    {% if block.settings.link contains 'http' %}
                    target="_blank"
                    rel="noopener noreferrer"
                    {% endif %}>
                {%- endif -%}

                {{ block.settings.image
 | image_url: width: 400
 | image_tag:
 class: 'growmodo-logo-list__image',
 widths: '150, 200, 300, 400',
 sizes: '(max-width: 749px) 120px, 200px',
 alt: logo_alt,
 loading: 'lazy'
                }}

                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              {%- else -%}
                <div class="growmodo-logo-list__link">
                  {{ 'image' | placeholder_svg_tag: 'growmodo-logo-list__placeholder' }}
                </div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
  {
    "name": "Growmodo Logo List",
    "tag": "section",
    "class": "section-growmodo-logo-list",
    "max_blocks": 12,
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#000000"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height",
        "min": 16,
        "max": 80,
        "step": 2,
        "unit": "px",
        "default": 32
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 24
      }
    ],
    "blocks": [
      {
        "type": "logo",
        "name": "Logo",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Logo image"
          },
          {
            "type": "text",
            "id": "alt",
            "label": "Alt text",
            "info": "Describe the logo for screen readers. Uses the image alt text if left blank."
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Growmodo Logo List",
        "blocks": [
          {
            "type": "logo"
          },
          {
            "type": "logo"
          },
          {
            "type": "logo"
          },
          {
            "type": "logo"
          },
          {
            "type": "logo"
          }
        ]
      }
    ]
  }
{% endschema %}