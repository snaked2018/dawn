{% comment %} 
        Growmodo product card for featured collection
       
        Accepts: 
        - card_product: {Object} Product 
        - lazy_load: {Boolean} 
        - show_rating: {Boolean} 
        - image_radius: {Number} px 
{% endcomment %}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign compare_at_price = card_product.compare_at_price
    assign price = card_product.price
    assign on_sale = false
    if compare_at_price > price
      assign on_sale = true
      assign discount_percent = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round
    endif
  -%}

  <article class="growmodo-product-card">
    <a href="{{ card_product.url }}" class="growmodo-product-card__link">
      <div class="growmodo-product-card__media" style="--growmodo-card-radius: {{ image_radius }}px;">
        {%- if card_product.featured_media -%}
          {%- liquid
            assign card_image_alt = card_product.featured_media.alt | escape
            assign card_image_sizes = '(min-width: 990px) 280px, (min-width: 750px) 220px, 75vw'
            if lazy_load
              assign card_image_loading = 'lazy'
            else
              assign card_image_loading = 'eager'
            endif
          -%}
          {{ card_product.featured_media
 | image_url: width: 800
 | image_tag:
 class: 'growmodo-product-card__image',
 widths: '165, 360, 533, 720, 800',
 sizes: card_image_sizes,
 alt: card_image_alt,
 loading: card_image_loading
          }}
        {%- else -%}
          {{ 'product-apparel-2' | placeholder_svg_tag: 'growmodo-product-card__placeholder' }}
        {%- endif -%}
      </div>

      <h3 class="growmodo-product-card__title">{{ card_product.title | escape }}</h3>

      {%- if show_rating -%}
        <div class="growmodo-product-card__rating">
          {%- if card_product.metafields.reviews.rating.value != blank -%}
            {%- liquid
              assign rating_decimal = 0
              assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1
              if decimal >= 0.3 and decimal <= 0.7
                assign rating_decimal = 0.5
              elsif decimal > 0.7
                assign rating_decimal = 1
              endif
            -%}
            <div
              class="rating"
              role="img"
              aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}">
              <span
                aria-hidden="true"
                class="rating-star"
                style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }}; --color-rating-star: #FFC633;"></span>
            </div>
            <span class="growmodo-product-card__rating-text">
              {{ card_product.metafields.reviews.rating.value.rating }}/{{ card_product.metafields.reviews.rating.value.scale_max }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="growmodo-product-card__price-row">
        <span class="growmodo-product-card__price">{{ price | money }}</span>
        {%- if on_sale -%}
          <span class="growmodo-product-card__compare-price">
            <s>{{ compare_at_price | money }}</s>
          </span>
          <span class="growmodo-product-card__badge">-{{ discount_percent }}%</span>
        {%- endif -%}
      </div>
    </a>
  </article>
{%- endif -%}