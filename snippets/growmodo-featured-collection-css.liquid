{{ 'component-rating.css' | asset_url | stylesheet_tag }}

<style>
  .growmodo-featured-collection__header {
    text-align: center;
    margin-bottom: 55px;
    margin-top: 72px;
  }

  .growmodo-featured-collection__title {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: uppercase;
    margin: 0;
  }

  .growmodo-featured-collection__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .growmodo-featured-collection__grid-item {
    min-width: 0;
  }

  .growmodo-featured-collection__swiper {
    display: none;
    overflow: hidden;
    margin: 0 -20px;
    padding: 0 20px;
  }

  .growmodo-featured-collection__swiper .swiper-slide {
    height: auto;
  }

  .growmodo-featured-collection__footer {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  .growmodo-featured-collection__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 160px;
    padding: 14px 48px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 999px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    color: #000;
    text-decoration: none;
    background: transparent;
    transition: border-color 0.2s ease
    , background-color 0.2s ease;
  }

  .growmodo-featured-collection__view-all:hover {
    border-color: rgba(0, 0, 0, 0.3);
    background-color: rgba(0, 0, 0, 0.02);
  }

  .growmodo-product-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .growmodo-product-card__media {
    background-color: #f2f0f1;
    border-radius: var(--growmodo-card-radius, 20px);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .growmodo-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .growmodo-product-card__placeholder {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .growmodo-product-card__title {
    font-family: var(--font-body-family);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 8px;
    color: #000;
  }

  .growmodo-product-card__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    min-height: 20px;
  }

  .growmodo-product-card__rating .rating-star {
    --letter-spacing: 0.4;
    --font-size: 1rem;
  }

  .growmodo-product-card__rating-text {
    font-size: 14px;
    line-height: 1;
    color: rgba(0, 0, 0, 0.6);
  }

  .growmodo-product-card__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  .growmodo-product-card__price {
    font-family: var(--font-body-family);
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
    color: #000;
  }

  .growmodo-product-card__compare-price {
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
    color: rgba(0, 0, 0, 0.4);
  }

  .growmodo-product-card__compare-price s {
    text-decoration: line-through;
  }

  .growmodo-product-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    background-color: #ffebf0;
    color: #ff3333;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {

    .growmodo-featured-collection__title {
      font-size: 32px;
    }

    .growmodo-featured-collection__header {
      margin-bottom: 32px;
      margin-top: 50px;
    }

    .growmodo-featured-collection__grid {
      display: none;
    }

    .growmodo-featured-collection__swiper {
      display: block;
    }

    .growmodo-featured-collection__footer {
      margin-top: 28px;
    }

    .growmodo-product-card__price,
    .growmodo-product-card__compare-price {
      font-size: 20px;
    }
  }
</style>