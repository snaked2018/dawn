<style>
    .growmodo-{{ section.id }}-container {
        background-color: #F3F0F1;
    }

    .growmodo-hero-banner__wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        justify-content: center;
        grid-template-rows: 663px;
        overflow: hidden;
        padding: 0 50px;
        margin: 0 20px;
    }

    .growmodo-hero-banner__content {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .growmodo-hero-banner__content h1 {
        font-size: 64px;
        letter-spacing: 0%;
        line-height: 64px;
    }

    .growmodo-hero-banner__content p {
        opacity: .6;
    }

    .growmodo-hero-banner__content * {
        margin: 0;
        text-decoration: none;
    }

    .growmodo-hero-banner__content a {
        color: #FFF;
    }

    .growmodo-hero-banner__image {
        width: 100%;
        height: 100%;
        min-height: 100%;
        background-size: cover;
        background-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;
        background-repeat: no-repeat;
        position: relative;
    }

    .growmodo-hero-banner__image .growmodo-hero-banner__diamond {
        position: absolute;
        z-index: 2;
        pointer-events: none;
        transform: translate(-50%, -50%);
    }

    .growmodo-hero-banner__image .growmodo-hero-banner__diamond-icon {
        display: block;
        line-height: 0;
    }

    .growmodo-hero-banner__image .growmodo-hero-banner__diamond-icon svg {
        width: 100%;
        height: 100%;
        display: block;
    }

    {%- for block in section.blocks -%}
        {%- if block.type == 'diamond' -%}
    .growmodo-{{ section.id }}-container .growmodo-hero-banner__image .growmodo-hero-banner__diamond--{{ block.id }} {
        left: {{ block.settings.position_x }}%;
        top: {{ block.settings.position_y }}%;
        width: {{ block.settings.size }}px;
        height: {{ block.settings.size }}px;
    }
        {%- endif -%}
    {%- endfor -%}

    {% if section.settings.image != blank %}
    .growmodo-{{ section.id }}-container .growmodo-hero-banner__image {
        background-image: url('{{ section.settings.image | image_url: width: 1500 }}');
    }
    {% endif %}

    .growmodo-hero-banner__title {
        font-size: 40px;
        font-weight: 700;
        line-height: 1.2;
        color: #000;
    }

    .growmodo-hero-banner__description {
        font-size: 16px;
        font-weight: 400;
        line-height: 1.5;
        color: #000;
    }

    .growmodo-hero-banner__buttons {
        display: flex;
        gap: 10px;
    }

    .growmodo-hero-banner__trust-cards {
        display: flex;
        flex-wrap: wrap;
        --trust-card-gap: 32px;
        gap: var(--trust-card-gap);
        margin-top: 28px;
    }

    .growmodo-hero-banner__trust-card {
        position: relative;
    }

    .growmodo-hero-banner__trust-card + .growmodo-hero-banner__trust-card::before {
        content: '';
        position: absolute;
        left: calc(var(--trust-card-gap) / -2);
        top: 50%;
        transform: translate(50%, -50%);
        width: .1px;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.1);
    }

    .growmodo-hero-banner__trust-card-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .growmodo-hero-banner__trust-card-value {
        font-size: 40px;
        font-weight: 700;
        line-height: 1.2;
        color: #000;
    }
    .growmodo-hero-banner__trust-card-label {
        font-size: 16px;
        font-weight: 400;
        line-height: 1.5;
        color: #000;
        opacity: .6;
    }

@media (max-width: 1230px) {
    .growmodo-hero-banner__content h1 {
        font-size: 42px;
        line-height: 48px;
    }
}

@media (max-width: 768px) {
    .growmodo-hero-banner__wrapper {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        align-items: start;
        padding: 40px 20px 0;
        margin: 0;
    }

    .growmodo-hero-banner__image {
        height: auto;
        min-height: 0;
        aspect-ratio: 1 / 1.15;
    }

    .growmodo-hero-banner__content {
        gap: 20px;
    }

    .growmodo-hero-banner__content h1 {
        font-size: 36px;
        line-height: 34px;
    }
    .growmodo-hero-banner__description {
        font-size: 14px;
        line-height: 1.4;
    }

    .growmodo-hero-banner__trust-cards {
        --trust-card-gap: 27.5px;
        margin-top: 0;
    }

    .growmodo-hero-banner__buttons {
        margin-top: 4px;
    }

    .growmodo-hero-banner__trust-card-value {
        font-size: 24px;
    }

    .growmodo-hero-banner__trust-card-label {
        font-size: 12px;
    }

    .growmodo-hero-banner__trust-cards {
        justify-content: center;
    }
    .growmodo-hero-banner__trust-card + .growmodo-hero-banner__trust-card:last-child::before {
        display: none;
    }
}

</style>